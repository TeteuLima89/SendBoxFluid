@model List<SessaoListaViewModel>
@{
    ViewData["Title"] = "Registro de Integracoes";
    var quantidadeSucesso = Model.Count(s => s.Resultado == "Sucesso");
    var quantidadeErro = Model.Count(s => s.Resultado == "Erro");
    var quantidadeAndamento = Model.Count(s => s.Resultado == "EmAndamento");
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total de Sessoes</h6>
                <h2 class="mb-0">@Model.Count</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-success">Sucesso</h6>
                <h2 class="mb-0 text-success">@quantidadeSucesso</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-danger">Erro</h6>
                <h2 class="mb-0 text-danger">@quantidadeErro</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-warning">Em Andamento</h6>
                <h2 class="mb-0 text-warning">@quantidadeAndamento</h2>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Sessoes de Integracao</h5>
        <div>
            <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">Atualizar</button>
            <button class="btn btn-outline-danger btn-sm" onclick="resetarSandbox()">Limpar Tudo</button>
        </div>
    </div>
    <div class="card-body">
        <table id="grid-sessoes" class="table table-striped table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Data/Hora</th>
                    <th>Acao</th>
                    <th>Resultado</th>
                    <th>Mensagem</th>
                    <th>Reqs</th>
                    <th>Acoes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sessao in Model)
                {
                    var classeBadge = sessao.Resultado switch
                    {
                        "Sucesso" => "badge-sucesso",
                        "Erro" => "badge-erro",
                        "EmAndamento" => "badge-emandamento",
                        _ => "badge-incompleto"
                    };
                    <tr>
                        <td>@sessao.DataInicio.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@sessao.TipoAcao</td>
                        <td><span class="badge @classeBadge">@sessao.Resultado</span></td>
                        <td>@sessao.Mensagem</td>
                        <td>@sessao.QuantidadeRequisicoes</td>
                        <td>
                            <a href="/painel/sessao/@sessao.CodigoSessao" class="btn btn-sm btn-primary">Ver detalhes</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#grid-sessoes").DataTable({
                order: [[0, 'desc']],
                pageLength: 20,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/pt-BR.json'
                }
            });
        });

        function resetarSandbox() {
            if (!confirm("Limpar TODAS as sessoes e documentos?")) return;
            fetch('/sandbox/reset', { method: 'DELETE' })
                .then(function () { location.reload(); });
        }
    </script>
}
