@model List<SessaoListaViewModel>
@{
    ViewData["Title"] = "Registro de Integracoes";
    var quantidadeSucesso = Model.Count(s => s.Resultado == "Sucesso");
    var quantidadeErro = Model.Count(s => s.Resultado == "Erro");
    var quantidadeAndamento = Model.Count(s => s.Resultado == "EmAndamento");
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted">Total de Sessoes</h6>
                <h2 class="mb-0">@Model.Count</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-success">Sucesso</h6>
                <h2 class="mb-0 text-success">@quantidadeSucesso</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-danger">Erro</h6>
                <h2 class="mb-0 text-danger">@quantidadeErro</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-warning">Em Andamento</h6>
                <h2 class="mb-0 text-warning">@quantidadeAndamento</h2>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Sessoes de Integracao</h5>
        <button class="btn btn-outline-danger btn-sm" onclick="resetarSandbox()">Limpar Tudo</button>
    </div>
    <div class="card-body p-0">
        <div id="grid-sessoes"></div>
    </div>
</div>

@section Scripts {
    <script>
        var dados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        $(function () {
            $("#grid-sessoes").kendoGrid({
                dataSource: {
                    data: dados,
                    pageSize: 20,
                    schema: {
                        model: {
                            fields: {
                                DataInicio: { type: "date" },
                                DataUltimaAtividade: { type: "date" },
                                QuantidadeRequisicoes: { type: "number" }
                            }
                        }
                    }
                },
                pageable: { pageSizes: [10, 20, 50] },
                sortable: true,
                filterable: true,
                columns: [
                    {
                        field: "DataInicio",
                        title: "Data/Hora",
                        format: "{0:dd/MM/yyyy HH:mm:ss}",
                        width: 170
                    },
                    {
                        field: "TipoAcao",
                        title: "Acao",
                        width: 220
                    },
                    {
                        field: "Resultado",
                        title: "Resultado",
                        width: 130,
                        template: function (item) {
                            var classe = "badge-incompleto";
                            if (item.Resultado === "Sucesso") classe = "badge-sucesso";
                            else if (item.Resultado === "Erro") classe = "badge-erro";
                            else if (item.Resultado === "EmAndamento") classe = "badge-emandamento";
                            return '<span class="badge ' + classe + '">' + item.Resultado + '</span>';
                        }
                    },
                    {
                        field: "Mensagem",
                        title: "Mensagem"
                    },
                    {
                        field: "QuantidadeRequisicoes",
                        title: "Reqs",
                        width: 70
                    },
                    {
                        title: "Acoes",
                        width: 200,
                        template: function (item) {
                            return '<a href="/painel/sessao/' + item.CodigoSessao + '" class="btn btn-sm btn-primary">Ver detalhes</a>';
                        }
                    }
                ]
            });
        });

        function resetarSandbox() {
            if (!confirm("Limpar TODAS as sessoes e documentos?")) return;
            fetch('/sandbox/reset', { method: 'DELETE' })
                .then(function () { location.reload(); });
        }
    </script>
}
