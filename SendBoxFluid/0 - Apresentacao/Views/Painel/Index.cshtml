@model List<SessaoListaViewModel>
@{
    var erpAtivo = ViewData["ErpAtivo"] as string ?? "todos";
    var titulosErp = new Dictionary<string, string>
    {
        ["todos"] = "Todas as Sessoes",
        ["sapb1"] = "SAP Business One",
        ["sankhya"] = "Sankhya"
    };
    var subtitulosErp = new Dictionary<string, string>
    {
        ["todos"] = "Todas as integracoes capturadas pelo SendBox",
        ["sapb1"] = "Integracoes via Service Layer SAP B1 (/b1s/v1/*)",
        ["sankhya"] = "Integracoes via Sankhya (/mge/service.sbr)"
    };
    var titulo = titulosErp.GetValueOrDefault(erpAtivo, "Sessoes");
    var subtitulo = subtitulosErp.GetValueOrDefault(erpAtivo, "");
    ViewData["Title"] = titulo;

    var quantidadeSucesso = Model.Count(s => s.Resultado == "Sucesso");
    var quantidadeErro = Model.Count(s => s.Resultado == "Erro");
    var quantidadeAndamento = Model.Count(s => s.Resultado == "EmAndamento");
}

<div class="cabecalho-pagina">
    <div>
        <h1>@titulo</h1>
        <p>@subtitulo</p>
    </div>
    <div>
        <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise"></i> Atualizar
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card-estatistica">
            <div class="rotulo">Total de Sessoes</div>
            <div class="valor">@Model.Count</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-estatistica sucesso">
            <div class="rotulo"><i class="bi bi-check-circle"></i> Sucesso</div>
            <div class="valor">@quantidadeSucesso</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-estatistica erro">
            <div class="rotulo"><i class="bi bi-x-circle"></i> Erro</div>
            <div class="valor">@quantidadeErro</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-estatistica aviso">
            <div class="rotulo"><i class="bi bi-clock"></i> Em Andamento</div>
            <div class="valor">@quantidadeAndamento</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox" style="font-size:48px;color:#d1d5db;"></i>
                <h5 class="mt-3 text-muted">Nenhuma sessao capturada</h5>
                <p class="text-muted small">
                    Dispare um fluxo no Fluid apontando o ERP para
                    <code>https://sendboxfluid.onrender.com</code>
                </p>
            </div>
        }
        else
        {
            <table id="grid-sessoes" class="table table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th style="width:130px">Data/Hora</th>
                        <th style="width:90px">ERP</th>
                        <th>Acao</th>
                        <th style="width:160px">Identificador</th>
                        <th style="width:120px">Resultado</th>
                        <th>Mensagem</th>
                        <th class="text-center" style="width:60px">Reqs</th>
                        <th style="width:120px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sessao in Model)
                    {
                        var classeBadge = sessao.Resultado switch
                        {
                            "Sucesso" => "badge-sucesso",
                            "Erro" => "badge-erro",
                            "EmAndamento" => "badge-emandamento",
                            _ => "badge-incompleto"
                        };
                        var classeErp = sessao.TipoErp switch
                        {
                            "SapB1" => "badge-erp-sapb1",
                            "Sankhya" => "badge-erp-sankhya",
                            _ => "badge-incompleto"
                        };
                        var nomeErp = sessao.TipoErp switch
                        {
                            "SapB1" => "SAP B1",
                            "Sankhya" => "Sankhya",
                            _ => "—"
                        };
                        <tr>
                            <td><small>@sessao.DataInicio.ToString("dd/MM HH:mm:ss")</small></td>
                            <td><span class="badge @classeErp">@nomeErp</span></td>
                            <td>@sessao.TipoAcao</td>
                            <td>
                                @if (!string.IsNullOrEmpty(sessao.IdentificadorNegocio))
                                {
                                    <span class="badge-identificador" title="@sessao.IdentificadorNegocio">
                                        <i class="bi bi-tag"></i> @sessao.IdentificadorNegocio
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @classeBadge">@sessao.Resultado</span></td>
                            <td><small class="text-muted text-truncate d-inline-block" style="max-width:300px;" title="@sessao.Mensagem">@sessao.Mensagem</small></td>
                            <td class="text-center"><span class="badge badge-incompleto">@sessao.QuantidadeRequisicoes</span></td>
                            <td class="text-end">
                                <a href="/painel/sessao/@sessao.CodigoSessao" class="btn btn-sm btn-primary">
                                    <i class="bi bi-eye"></i> Detalhes
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($("#grid-sessoes tbody tr").length > 0) {
                var table = $("#grid-sessoes").DataTable({
                    order: [[0, 'desc']],
                    pageLength: 25,
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/2.1.8/i18n/pt-BR.json',
                        searchPlaceholder: 'Buscar por identificador...'
                    },
                    initComplete: function () {
                        var api = this.api();
                        var divFiltro = $('<div class="d-flex align-items-center gap-2 mb-3"></div>');
                        var label = $('<label class="text-muted small mb-0">Filtrar resultado:</label>');
                        var select = $('<select class="form-select form-select-sm" style="width:auto"></select>')
                            .append('<option value="">Todos</option>')
                            .append('<option value="Sucesso">Sucesso</option>')
                            .append('<option value="Erro">Erro</option>')
                            .append('<option value="EmAndamento">Em Andamento</option>')
                            .append('<option value="Incompleto">Incompleto</option>')
                            .on('change', function () {
                                api.column(4).search($(this).val()).draw();
                            });
                        divFiltro.append(label).append(select);
                        $(api.table().container()).prepend(divFiltro);
                    }
                });
            }
        });
    </script>
}
