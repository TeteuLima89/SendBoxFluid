@model List<SendBoxFluid.Dominio.Entidades.ConfiguracaoNarwal>
@{
    ViewData["Title"] = "Configuracao Narwal";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Configuracao Narwal</h1>
        <p>Conecte o SendBox ao Narwal pra enriquecer cada integracao com os dados originais (consulta-xml, processo, despesa)</p>
    </div>
</div>

@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["MensagemSucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["MensagemErro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["MensagemErro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Adicionar / Atualizar</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/painel/configuracao/narwal/salvar">
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <input name="cliente" class="form-control" placeholder="rivatti, alpargatas, etc" required />
                        <small class="text-muted">Identificador unico do cliente</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">URL Narwal</label>
                        <input name="urlNarwal" class="form-control" placeholder="https://rivattiapi.narwalsistemas.com.br" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input name="usuario" class="form-control" value="integracao" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input name="senha" type="password" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar Configuracao
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-list"></i> Configuracoes Salvas</h5>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox" style="font-size:32px;"></i>
                        <p class="mt-2 mb-0">Nenhuma configuracao</p>
                        <small>Adicione uma configuracao para enriquecer as sessoes com dados Narwal</small>
                    </div>
                }
                else
                {
                    foreach (var config in Model)
                    {
                        <div class="border rounded p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@config.Cliente</strong>
                                    <div class="small text-muted"><code>@config.UrlNarwal</code></div>
                                    <div class="small text-muted">Usuario: @config.Usuario</div>
                                </div>
                                <form method="post" action="/painel/configuracao/narwal/remover" onsubmit="return confirm('Remover @config.Cliente?')">
                                    <input type="hidden" name="cliente" value="@config.Cliente" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6><i class="bi bi-info-circle"></i> Como funciona</h6>
                <ol class="small mb-0">
                    <li>SendBox detecta o identificador (NfeId, ProcessoId) no payload</li>
                    <li>Consulta automaticamente o Narwal usando essa configuracao</li>
                    <li>Mostra os dados originais na aba "Dados Originais (Narwal)" da sessao</li>
                </ol>
            </div>
        </div>
    </div>
</div>
