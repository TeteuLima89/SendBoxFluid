@model SessaoDetalheViewModel
@{
    ViewData["Title"] = "Detalhes da Sessao";
    var classeBadge = Model.Resultado switch
    {
        "Sucesso" => "badge-sucesso",
        "Erro" => "badge-erro",
        "EmAndamento" => "badge-emandamento",
        _ => "badge-incompleto"
    };
    var temDadosNarwal = !string.IsNullOrEmpty(Model.DadosOriginaisNarwal);
    var consultas = Model.Requisicoes.Where(r => r.Metodo.Equals("GET", StringComparison.OrdinalIgnoreCase)).ToList();
    var acoes = Model.Requisicoes.Where(r => !r.Metodo.Equals("GET", StringComparison.OrdinalIgnoreCase)).ToList();
}

<div class="cabecalho-pagina">
    <div>
        <h1>@Model.TipoAcao</h1>
        <p>
            <span class="badge @classeBadge">@Model.Resultado</span>
            @if (!string.IsNullOrEmpty(Model.IdentificadorNegocio))
            {
                <span class="badge-identificador ms-2"><i class="bi bi-tag"></i> @Model.IdentificadorNegocio</span>
            }
            <span class="text-muted ms-2 small">@Model.DataInicio.ToString("dd/MM/yyyy HH:mm:ss")</span>
        </p>
    </div>
    <div>
        <a href="/painel/sessao/@Model.CodigoSessao/download/relatorio" class="btn btn-success btn-sm">
            <i class="bi bi-download"></i> Baixar Relatorio
        </a>
        <a href="/painel/sessao/@Model.CodigoSessao/download/payload" class="btn btn-info btn-sm">
            <i class="bi bi-download"></i> Baixar Payload
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert alert-light border mb-3">
        <i class="bi bi-info-circle"></i> @Model.Mensagem
    </div>
}

<div class="row g-3 mb-3">
    <!-- COLUNA ESQUERDA: Origem (Narwal) -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-arrow-up-circle text-primary"></i> Origem (Narwal)
                </h5>
                <span class="badge badge-erp-sapb1">consulta-xml</span>
            </div>
            <div class="card-body p-0">
                @if (temDadosNarwal)
                {
                    <p class="text-muted small px-3 pt-3 mb-2">
                        Dados originais retornados pelo Narwal (mesma resposta do passo consulta-xml do fluxo)
                    </p>
                    <div class="json-box" style="border-radius:0 0 6px 6px; max-height:600px;">@Model.DadosOriginaisNarwal</div>
                }
                else
                {
                    <div class="alert alert-warning m-3 mb-0">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Dados Narwal nao configurados.</strong><br />
                        <a href="/painel/configuracao" class="alert-link">Configure o acesso</a>
                        para ver aqui os dados originais (NF, processo, despesa).
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- COLUNA DIREITA: Destino (ERP) -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-arrow-down-circle text-success"></i> Destino (ERP)
                </h5>
                <span class="badge badge-erp-sapb1">@acoes.Count acao(es)</span>
            </div>
            <div class="card-body p-0">
                @if (acoes.Any())
                {
                    <p class="text-muted small px-3 pt-3 mb-2">
                        Payload(s) enviado(s) pro ERP (Drafts, LandedCosts, JournalEntries, etc)
                    </p>
                    <div class="accordion accordion-flush" id="acordeao-acoes">
                        @for (var i = 0; i < acoes.Count; i++)
                        {
                            var req = acoes[i];
                            var classeStatus = req.CodigoStatusHttp >= 400 ? "text-danger" : "text-success";
                            var corMetodo = req.Metodo switch
                            {
                                "POST" => "bg-success",
                                "PATCH" => "bg-warning",
                                "DELETE" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#acao-@i">
                                        <span class="badge @corMetodo me-2">@req.Metodo</span>
                                        <code class="me-2 small">@req.Caminho</code>
                                        <span class="ms-auto me-3 small @classeStatus">HTTP @req.CodigoStatusHttp</span>
                                    </button>
                                </h2>
                                <div id="acao-@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#acordeao-acoes">
                                    <div class="accordion-body p-2">
                                        @if (!string.IsNullOrEmpty(req.CorpoRequisicao))
                                        {
                                            <h6 class="small mb-1"><i class="bi bi-arrow-up"></i> Enviado</h6>
                                            <div class="json-box mb-2" style="max-height:350px; font-size:12px;">@req.CorpoRequisicao</div>
                                        }
                                        <h6 class="small mb-1"><i class="bi bi-arrow-down"></i> Resposta</h6>
                                        <div class="json-box" style="max-height:200px; font-size:12px;">@req.CorpoResposta</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light m-3 mb-0">Sem acoes registradas</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Linha de baixo: consultas SAP + Relatorio -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-search"></i> Consultas no ERP
                    <span class="badge bg-secondary">@consultas.Count</span>
                </h5>
            </div>
            <div class="card-body p-0">
                @if (consultas.Any())
                {
                    <p class="text-muted small px-3 pt-3 mb-2">
                        GETs feitos no ERP pra buscar dados (PurchaseOrders, NFs anteriores, etc)
                    </p>
                    <div class="accordion accordion-flush" id="acordeao-consultas">
                        @for (var i = 0; i < consultas.Count; i++)
                        {
                            var req = consultas[i];
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#consulta-@i">
                                        <span class="badge bg-primary me-2">GET</span>
                                        <code class="small">@req.Caminho</code>
                                    </button>
                                </h2>
                                <div id="consulta-@i" class="accordion-collapse collapse" data-bs-parent="#acordeao-consultas">
                                    <div class="accordion-body p-2">
                                        <div class="json-box" style="max-height:250px; font-size:12px;">@req.CorpoResposta</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light m-3 mb-0 small">Sem consultas neste fluxo</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> Relatorio (formato Narwal)
                </h5>
            </div>
            <div class="card-body p-0">
                <p class="text-muted small px-3 pt-3 mb-2">
                    JSON exatamente como seria enviado pro Narwal via /api/eventointegracao/v1/retornointegracao
                </p>
                <div class="json-box" style="border-radius:0 0 6px 6px; max-height:400px;">@Model.JsonRelatorio</div>
            </div>
        </div>
    </div>
</div>
