@model SessaoDetalheViewModel
@{
    ViewData["Title"] = "Detalhes da Sessao";
    var classeBadge = Model.Resultado switch
    {
        "Sucesso" => "badge-sucesso",
        "Erro" => "badge-erro",
        "EmAndamento" => "badge-emandamento",
        _ => "badge-incompleto"
    };
}

<div class="cabecalho-pagina">
    <div>
        <h1>@Model.TipoAcao</h1>
        <p>
            <span class="badge @classeBadge">@Model.Resultado</span>
            <span class="text-muted ms-2">Sessao: <code>@Model.CodigoSessao</code></span>
        </p>
    </div>
    <div>
        <a href="/painel/sessao/@Model.CodigoSessao/download/relatorio" class="btn btn-success btn-sm">
            <i class="bi bi-download"></i> Baixar Relatorio
        </a>
        <a href="/painel/sessao/@Model.CodigoSessao/download/payload" class="btn btn-info btn-sm">
            <i class="bi bi-download"></i> Baixar Payload
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <small class="text-muted d-block">Inicio</small>
                <strong>@Model.DataInicio.ToString("dd/MM/yyyy HH:mm:ss")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Ultima atividade</small>
                <strong>@Model.DataUltimaAtividade.ToString("dd/MM/yyyy HH:mm:ss")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Requisicoes capturadas</small>
                <strong>@Model.Requisicoes.Count</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Mensagem</small>
                <strong>@(string.IsNullOrEmpty(Model.Mensagem) ? "—" : Model.Mensagem)</strong>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#aba-relatorio">
            <i class="bi bi-file-earmark-text"></i> Relatorio (formato Narwal)
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#aba-requisicoes">
            <i class="bi bi-list-ul"></i> Requisicoes (@Model.Requisicoes.Count)
        </button>
    </li>
</ul>

<div class="tab-content border border-top-0 bg-white p-4 rounded-bottom">
    <div class="tab-pane fade show active" id="aba-relatorio">
        <p class="text-muted small mb-3">
            <i class="bi bi-info-circle"></i>
            JSON exatamente como seria enviado pro Narwal via /api/eventointegracao/v1/retornointegracao
        </p>
        <div class="json-box">@Model.JsonRelatorio</div>
    </div>

    <div class="tab-pane fade" id="aba-requisicoes">
        <div class="accordion" id="acordeao-reqs">
            @for (var i = 0; i < Model.Requisicoes.Count; i++)
            {
                var req = Model.Requisicoes[i];
                var classeStatus = req.CodigoStatusHttp >= 400 ? "text-danger" : "text-success";
                var corMetodo = req.Metodo switch
                {
                    "POST" => "bg-success",
                    "GET" => "bg-primary",
                    "PATCH" => "bg-warning",
                    "DELETE" => "bg-danger",
                    _ => "bg-secondary"
                };
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#req-@i">
                            <span class="badge @corMetodo me-2">@req.Metodo</span>
                            <code class="me-3">@req.Caminho</code>
                            <span class="ms-auto me-3 @classeStatus">HTTP @req.CodigoStatusHttp</span>
                            <small class="text-muted">@req.DataHora.ToString("HH:mm:ss")</small>
                        </button>
                    </h2>
                    <div id="req-@i" class="accordion-collapse collapse" data-bs-parent="#acordeao-reqs">
                        <div class="accordion-body">
                            @if (!string.IsNullOrEmpty(req.CorpoRequisicao))
                            {
                                <h6 class="mb-2"><i class="bi bi-arrow-up-circle"></i> Requisicao</h6>
                                <div class="json-box mb-3">@req.CorpoRequisicao</div>
                            }
                            <h6 class="mb-2"><i class="bi bi-arrow-down-circle"></i> Resposta</h6>
                            <div class="json-box">@req.CorpoResposta</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
