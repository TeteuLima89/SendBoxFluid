@{
    var titulo = ViewData["Title"] as string ?? "SendBox Fluid";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@titulo - SendBox Fluid</title>

    <link rel="stylesheet" href="https://cdn.kendostatic.com/2023.3.1010/styles/kendo.default-v2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <style>
        body { background-color: #f5f5f5; }
        .navbar-brand { font-weight: 600; }
        .badge-sucesso { background-color: #28a745; color: white; }
        .badge-erro { background-color: #dc3545; color: white; }
        .badge-emandamento { background-color: #ffc107; color: #333; }
        .badge-incompleto { background-color: #6c757d; color: white; }
        .json-box {
            background-color: #1e1e1e;
            color: #d4d4d4;
            padding: 16px;
            border-radius: 6px;
            font-family: 'Consolas', monospace;
            font-size: 13px;
            max-height: 500px;
            overflow: auto;
            white-space: pre-wrap;
        }
        .header-painel {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 24px 0;
            margin-bottom: 24px;
        }
    </style>
</head>
<body>
    <div class="header-painel">
        <div class="container">
            <h2 class="mb-0">SendBox Fluid <small class="opacity-75">— painel do QA</small></h2>
            <a href="/painel" class="text-white text-decoration-none small">Voltar para listagem</a>
        </div>
    </div>

    <div class="container">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.kendostatic.com/2023.3.1010/js/kendo.all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
